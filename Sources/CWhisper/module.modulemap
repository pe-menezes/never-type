// Bridge to the whisper.cpp built statically in vendor/whisper.
//
// Paths are relative to this file: SwiftPM resolves the headers of a
// `systemLibrary` target at import time, before any consumer flag.
//
// `ggml-backend.h` comes along because `ggml_backend_dev_count`, `_dev_get` and
// `_dev_name` live there and are not exposed by `whisper.h` (which includes only
// ggml.h and ggml-cpu.h). They are what Transcriber.swift uses to enumerate the
// devices and prove Metal is active. `ggml_backend_load_all()`, the original
// reason for this header, was removed from the app — see the comment in
// `Transcriber.init`.
module CWhisper [system] {
    header "../../vendor/whisper/include/whisper.h"
    header "../../vendor/whisper/include/ggml-backend.h"
    export *
}
